# ══════════════════════════════════════════════════════
#  Notes App — Environment Variables
# ══════════════════════════════════════════════════════
#  Copy this file to .env and fill in the values.
#  DO NOT commit .env to version control.
# ══════════════════════════════════════════════════════

# Database URL
# Local (SQLite):      sqlite:///./notes.db
# Production (PostgreSQL): postgresql://user:password@localhost:5432/notesdb
DATABASE_URL=sqlite:///./notes.db

# JWT Secret Key — generate a strong random key for production
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a-very-secret-key-change-this-in-production

# JWT token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60
